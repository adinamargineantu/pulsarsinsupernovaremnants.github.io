<script>
(function () {
  const table = document.getElementById('assoc-table');
  const tbody = document.getElementById('table-body');
  const searchBox = document.getElementById('search');
  const countEl = document.getElementById('count');
  const headers = table.querySelectorAll('thead th[data-key]');
  const allRows = Array.from(tbody.querySelectorAll('tr'));

  function updateCount() {
    const visible = allRows.filter(r => r.style.display !== 'none').length;
    countEl.textContent = visible + ' of ' + allRows.length + ' associations';
  }

  function filterRows() {
    const q = searchBox.value.trim().toLowerCase();
    allRows.forEach(row => {
      const text = row.textContent.toLowerCase();
      row.style.display = (!q || text.includes(q)) ? '' : 'none';
    });
    updateCount();
  }

  searchBox.addEventListener('input', filterRows);

  let currentSort = { key: null, dir: 1 };

  function cellValue(row, key, type) {
    const cell = row.querySelector('[data-col="' + key + '"]');
    const raw = cell ? cell.getAttribute('data-sort') || cell.textContent.trim() : '';
    if (type === 'num') {
      const n = parseFloat(raw);
      return isNaN(n) ? -Infinity : n;
    }
    return raw.toLowerCase();
  }

  headers.forEach(th => {
    if (th.classList.contains('no-sort')) return;
    th.addEventListener('click', () => {
      const key = th.getAttribute('data-key');
      const type = th.getAttribute('data-type') || 'text';
      if (currentSort.key === key) {
        currentSort.dir *= -1;
      } else {
        currentSort = { key, dir: 1 };
      }
      headers.forEach(h => h.querySelector('.arrow') && h.querySelector('.arrow').remove());
      const arrow = document.createElement('span');
      arrow.className = 'arrow';
      arrow.textContent = currentSort.dir === 1 ? ' \u2191' : ' \u2193';
      th.appendChild(arrow);

      const sorted = allRows.slice().sort((a, b) => {
        const va = cellValue(a, key, type);
        const vb = cellValue(b, key, type);
        if (va < vb) return -1 * currentSort.dir;
        if (va > vb) return 1 * currentSort.dir;
        return 0;
      });
      sorted.forEach(r => tbody.appendChild(r));
    });
  });

  updateCount();
})();
</script>
</body>
</html>
